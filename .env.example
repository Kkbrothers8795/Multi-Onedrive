# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="https://ais-dev-dvc2cvhrcuguyy57g7c6rv-186422582482.asia-east1.run.app"

# GEMINI_API_KEY: Optional for AI Studio capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"
