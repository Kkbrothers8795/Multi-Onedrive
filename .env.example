# Microsoft Azure AD / Entra ID OAuth 2.0 Credentials
# Register in Azure Portal -> Microsoft Entra ID -> App registrations
# Add Redirect URI: <APP_URL>/auth/callback (Web platform)
# API Permissions: Microsoft Graph -> Files.ReadWrite.All, User.Read, offline_access
CLIENT_ID="YOUR_AZURE_CLIENT_ID"
CLIENT_SECRET="YOUR_AZURE_CLIENT_SECRET"
TENANT_ID="common"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="https://ais-dev-dvc2cvhrcuguyy57g7c6rv-186422582482.asia-east1.run.app"

# Security & Admin Authentication Vault
ADMIN_PASSWORD="admin123"
APP_SECRET="multidrive_enterprise_secret_key_2026"

# Optional External Cloud Database Drivers (for Vercel Serverless / Multi-Region Sync)
# Built-in SQLite WAL is active automatically on VPS / Node.js 22+
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
FIREBASE_DB_URL=""
FIREBASE_DB_SECRET=""
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Optional for AI Studio capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

